  {
    "id": "deco-github-snake",
    "type": "url-component",
    "name": "GitHub Contribution Snake",
    "description": "An animated snake eating your contribution graph. GitHub Only, and needs one-time setup — the Platane/snk GitHub Action must already be publishing this SVG to your profile repo's `output` branch.",
