    "tags": ["Decorations", "Animation", "GitHub Only"],
    "defaultSettings": { "username": "platane" },
    "meta": {
      "urlTemplate": "https://raw.githubusercontent.com/{username}/{username}/output/github-contribution-grid-snake.svg",
      "linkable": false,
      "fields": [{ "key": "username", "label": "GitHub Username", "type": "text" }]
    }
