{
  "id": "ryo-ma-stats-github-profile-trophy",
  "type": "url-component",
  "name": "GitHub Profile Trophy",
  "description": "A row of trophies for stars, commits, PRs, and more. GitHub Only — computed from your GitHub activity via the GitHub API.",
  "category": "Stats",
  "tags": ["Stats", "Card", "GitHub Only"],
  "defaultSettings": { "username": "octocat", "theme": "flat", "column": "6", "row": "1" },
  "meta": {
    "urlTemplate": "https://github-profile-trophy.vercel.app/?username={username}&theme={theme}&column={column}&row={row}",
    "altTemplate": "{username}'s GitHub Trophies",
    "linkable": false,
    "fields": [
      { "key": "username", "label": "GitHub Username", "type": "text" },
      {
        "key": "theme",
        "label": "Theme",
        "type": "select",
        "options": [
          { "value": "flat", "label": "Flat" },
          { "value": "onedark", "label": "One Dark" },
          { "value": "dracula", "label": "Dracula" },
          { "value": "monokai", "label": "Monokai" },
          { "value": "radical", "label": "Radical" },
          { "value": "tokyonight", "label": "Tokyo Night" },
          { "value": "gruvbox", "label": "Gruvbox" },
          { "value": "nord", "label": "Nord" },
          { "value": "discord", "label": "Discord" }
        ]
      },
      { "key": "column", "label": "Columns", "type": "number", "min": 1, "max": 10, "step": 1 },
      { "key": "row", "label": "Rows", "type": "number", "min": 1, "max": 5, "step": 1 }
    ]
  }
}
