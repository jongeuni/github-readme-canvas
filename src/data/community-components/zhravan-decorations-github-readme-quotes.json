{
  "id": "zhravan-decorations-github-readme-quotes",
  "type": "url-component",
  "name": "Random Quote",
  "description": "A card showing a different quote every time it's rendered. Works anywhere — not GitHub-specific.",
  "category": "Decorations",
  "tags": ["Decorations", "Card"],
  "defaultSettings": { "theme": "dark", "quoteCategory": "general" },
  "meta": {
    "urlTemplate": "https://github-readme-quotes-bay.vercel.app/quote?theme={theme}&quoteCategory={quoteCategory}",
    "altTemplate": "Random Quote",
    "linkable": false,
    "fields": [
      {
        "key": "theme",
        "label": "Theme",
        "type": "select",
        "options": [
          { "value": "dark", "label": "Dark" },
          { "value": "radical", "label": "Radical" },
          { "value": "merko", "label": "Merko" },
          { "value": "gruvbox", "label": "Gruvbox" },
          { "value": "tokyonight", "label": "Tokyo Night" },
          { "value": "onedark", "label": "One Dark" },
          { "value": "cobalt", "label": "Cobalt" },
          { "value": "synthwave", "label": "Synthwave" },
          { "value": "highcontrast", "label": "High Contrast" },
          { "value": "dracula", "label": "Dracula" }
        ]
      },
      {
        "key": "quoteCategory",
        "label": "Category",
        "type": "select",
        "options": [
          { "value": "general", "label": "General" },
          { "value": "life", "label": "Life" },
          { "value": "success", "label": "Success" },
          { "value": "motivational", "label": "Motivational" },
          { "value": "fun", "label": "Fun" },
          { "value": "programming", "label": "Programming" },
          { "value": "dream", "label": "Dream" },
          { "value": "failure", "label": "Failure" },
          { "value": "gaming", "label": "Gaming" },
          { "value": "birthday", "label": "Birthday" }
        ]
      }
    ]
  }
}
