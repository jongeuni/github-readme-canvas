{
  "id": "stats-github-forks",
  "type": "url-component",
  "name": "GitHub Repo Forks",
  "description": "A live fork-count badge for a repository. GitHub Only — the fork count comes from the GitHub API, so it only works for GitHub repos.",
  "category": "Stats",
  "tags": [
    "Stats",
    "Badge",
    "GitHub Only"
  ],
  "defaultSettings": {
    "owner": "octocat",
    "repo": "Hello-World",
    "link": ""
  },
  "meta": {
    "urlTemplate": "https://img.shields.io/github/forks/{owner}/{repo}?style=social",
    "linkable": true,
    "fields": [
      {
        "key": "owner",
        "label": "Repo Owner",
        "type": "text"
      },
      {
        "key": "repo",
        "label": "Repo Name",
        "type": "text"
      }
    ]
  }
}
