{
  "type": "url-component",
  "name": "Box Generator",
  "description": "A styled info box showing a title, author, and date. Not GitHub-specific.",
  "category": "🌐 social",
  "tags": [
    "🌐 social"
  ],
  "status": "active",
  "author": "jongeuni",
  "projectUrl": "https://github.com/jongeuni/markdown-box-generator",
  "defaultSettings": {
    "title": "Welcome",
    "author": "readme canvas",
    "date": "Date",
    "style": "DEFAULT",
    "link": ""
  },
  "meta": {
    "urlTemplate": "https://markdown-box-generator.vercel.app/api/box?title={title}&author={author}&date={date}&style={style}",
    "linkable": true,
    "fields": [
      {
        "key": "title",
        "label": "Title",
        "type": "text"
      },
      {
        "key": "author",
        "label": "Author",
        "type": "text"
      },
      {
        "key": "date",
        "label": "Date",
        "type": "text"
      },
      {
        "key": "style",
        "label": "Style",
        "type": "select",
        "options": [
          {
            "value": "DEFAULT",
            "label": "DEFAULT",
            "swatch": "#2563eb"
          },
          {
            "value": "GLOW",
            "label": "GLOW (neon)",
            "swatch": "#2563eb"
          },
          {
            "value": "GITHUB",
            "label": "GITHUB",
            "swatch": "#2563eb"
          },
          {
            "value": "MEDIUM",
            "label": "MEDIUM",
            "swatch": "#2563eb"
          },
          {
            "value": "LIINKED",
            "label": "LIINKED",
            "swatch": "#2563eb"
          },
          {
            "value": "INSTA",
            "label": "INSTA",
            "swatch": "#2563eb"
          },
          {
            "value": "BRUNCH",
            "label": "BRUNCH",
            "swatch": "#2563eb"
          },
          {
            "value": "TISTORY",
            "label": "TISTORY",
            "swatch": "#2563eb"
          },
          {
            "value": "VELOG",
            "label": "VELOG",
            "swatch": "#2563eb"
          },
          {
            "value": "NAVER",
            "label": "NAVER",
            "swatch": "#2563eb"
          }
        ]
      }
    ]
  },
  "presetsLabel": "styles",
  "presets": [
    { "id": "social-jongeuni-box-generator-default", "name": "DEFAULT", "settings": { "style": "DEFAULT" } },
    { "id": "social-jongeuni-box-generator-glow", "name": "GLOW (neon)", "settings": { "style": "GLOW" } },
    { "id": "social-jongeuni-box-generator-github", "name": "GITHUB", "settings": { "style": "GITHUB" } },
    { "id": "social-jongeuni-box-generator-medium", "name": "MEDIUM", "settings": { "style": "MEDIUM" } },
    { "id": "social-jongeuni-box-generator-liinked", "name": "LIINKED", "settings": { "style": "LIINKED" } },
    { "id": "social-jongeuni-box-generator-insta", "name": "INSTA", "settings": { "style": "INSTA" } },
    { "id": "social-jongeuni-box-generator-brunch", "name": "BRUNCH", "settings": { "style": "BRUNCH" } },
    { "id": "social-jongeuni-box-generator-tistory", "name": "TISTORY", "settings": { "style": "TISTORY" } },
    { "id": "social-jongeuni-box-generator-velog", "name": "VELOG", "settings": { "style": "VELOG" } },
    { "id": "social-jongeuni-box-generator-naver", "name": "NAVER", "settings": { "style": "NAVER" } }
  ],
  "id": "social-jongeuni-box-generator-2"
}
