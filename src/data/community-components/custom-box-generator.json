          },
          {
            "value": "GITHUB",
            "label": "GITHUB",
            "swatch": "#2563eb"
          },
          {
            "value": "GLOW",
            "label": "GLOW",
            "swatch": "#2563eb"
          },
          {
            "value": "BRUNCH",
            "label": "BRUNCH",
            "swatch": "#2563eb"
          },
          {
            "value": "TISTORY",
            "label": "TISTORY",
            "swatch": "#2563eb"
          },
          {
            "value": "NAVER",
            "label": "NAVER",
            "swatch": "#2563eb"
          },
          {
            "value": "VELOG",
            "label": "VELOG",
            "swatch": "#2563eb"
          },
          {
            "value": "DEFAULT",
            "label": "DEFAULT",
            "swatch": "#2563eb"
