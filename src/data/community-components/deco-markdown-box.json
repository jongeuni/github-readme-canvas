{
  "id": "deco-markdown-box",
  "type": "url-component",
  "name": "Markdown Box",
  "description": "A styled info box showing a title, author, and date. Not GitHub-specific.",
  "category": "Decorations",
  "tags": [
    "Decorations"
  ],
  "defaultSettings": {
    "title": "Default_Title",
    "author": "Author",
    "date": "2025-7-28",
    "style": "default",
    "link": "https://github.com/jongeuni/markdown-box-generator"
  },
  "meta": {
    "urlTemplate": "https://markdown-box-generator.vercel.app/api/box?title={title}&author={author}&date={date}&style={style}",
    "linkable": true,
    "altTemplate": "box",
    "fields": [
      {
        "key": "title",
        "label": "Title",
        "type": "text"
      },
      {
        "key": "author",
        "label": "Author",
        "type": "text"
      },
      {
        "key": "date",
        "label": "Date",
        "type": "text"
      },
      {
        "key": "style",
        "label": "Style",
        "type": "text"
      }
    ]
  }
}
