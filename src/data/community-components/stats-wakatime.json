{
  "id": "stats-wakatime",
  "type": "url-component",
  "name": "WakaTime Weekly Stats",
  "description": "A card of your weekly coding activity by language. Needs a public WakaTime profile — the data source is WakaTime, not GitHub.",
  "category": "Stats",
  "tags": [
    "Stats",
    "Card"
  ],
  "defaultSettings": {
    "wakatimeUsername": "alex123",
    "theme": "default"
  },
  "meta": {
    "urlTemplate": "https://github-readme-stats.vercel.app/api/wakatime?username={wakatimeUsername}&theme={theme}",
    "linkable": false,
    "fields": [
      {
        "key": "wakatimeUsername",
        "label": "WakaTime Username",
        "type": "text"
      },
      {
        "key": "theme",
        "label": "Theme",
        "type": "select",
        "options": [
          {
            "value": "default",
            "label": "Default"
          },
          {
            "value": "dark",
            "label": "Dark"
          },
          {
            "value": "radical",
            "label": "Radical"
          },
          {
            "value": "merko",
            "label": "Merko"
          }
        ]
      }
    ]
  }
}
