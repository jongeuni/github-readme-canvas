{
  "id": "status-github-actions",
  "type": "url-component",
  "name": "GitHub Actions Status",
  "description": "Shows the pass/fail status of a GitHub Actions workflow. GitHub Only — requires a workflow file already running in the repo's Actions tab.",
  "category": "📊 status",
  "tags": [
    "📊 status",
    "Badge",
    "GitHub Only"
  ],
  "status": "active",
  "author": "",
  "projectUrl": "https://shields.io",
  "defaultSettings": {
    "owner": "octocat",
    "repo": "Hello-World",
    "workflow": "ci.yml",
    "branch": ""
  },
  "meta": {
    "urlTemplate": "https://img.shields.io/github/actions/workflow/status/{owner}/{repo}/{workflow}?branch={branch}&style=flat",
    "linkTemplate": "https://github.com/{owner}/{repo}/actions",
    "linkable": false,
    "fields": [
      {
        "key": "owner",
        "label": "Repository Owner",
        "type": "text"
      },
      {
        "key": "repo",
        "label": "Repository Name",
        "type": "text"
      },
      {
        "key": "workflow",
        "label": "Workflow File (e.g. ci.yml)",
        "type": "text"
      },
      {
        "key": "branch",
        "label": "Branch (optional — default branch if empty)",
        "type": "text"
      }
    ]
  }
}
