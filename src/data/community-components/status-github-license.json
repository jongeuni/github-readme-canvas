{
  "id": "status-github-license",
  "type": "url-component",
  "name": "GitHub License",
  "description": "Shows a repository's license. GitHub Only — read from the repo's metadata via the GitHub API.",
  "category": "📊 status",
  "tags": [
    "📊 status",
    "Badge",
    "GitHub Only"
  ],
  "defaultSettings": {
    "owner": "octocat",
    "repo": "Hello-World"
  },
  "meta": {
    "urlTemplate": "https://img.shields.io/github/license/{owner}/{repo}?style=flat",
    "linkable": false,
    "fields": [
      {
        "key": "owner",
        "label": "Repo Owner",
        "type": "text"
      },
      {
        "key": "repo",
        "label": "Repo Name",
        "type": "text"
      }
    ]
  }
}
