{
  "id": "tech-tool-badge",
  "type": "url-component",
  "name": "Tool Badge",
  "description": "A badge for your favorite tool.",
  "category": "🧑‍💻 tech",
  "tags": [
    "🧑‍💻 tech",
    "Badge"
  ],
  "defaultSettings": {
    "label": "Docker",
    "color": "blue",
    "style": "flat",
    "link": "https://docker.com"
  },
  "meta": {
    "urlTemplate": "https://img.shields.io/badge/{label}-{color}?style={style}",
    "altTemplate": "{label}",
    "linkable": true,
    "fields": [
      {
        "key": "label",
        "label": "Label",
        "type": "text"
      },
      {
        "key": "style",
        "label": "Style",
        "type": "select",
        "options": [
          {
            "value": "flat",
            "label": "Flat"
          },
          {
            "value": "flat-square",
            "label": "Flat Square"
          },
          {
            "value": "for-the-badge",
            "label": "For The Badge"
          },
          {
            "value": "plastic",
            "label": "Plastic"
          }
        ]
      },
      {
        "key": "color",
        "label": "Color",
        "type": "color",
        "options": [
          {
            "value": "blue",
            "label": "blue",
            "swatch": "#2563eb"
          },
          {
            "value": "green",
            "label": "green",
            "swatch": "#16a34a"
          },
          {
            "value": "red",
            "label": "red",
            "swatch": "#dc2626"
          },
          {
            "value": "orange",
            "label": "orange",
            "swatch": "#ea580c"
          },
          {
            "value": "purple",
            "label": "purple",
            "swatch": "#9333ea"
          },
          {
            "value": "black",
            "label": "black",
            "swatch": "#18181b"
          },
          {
            "value": "gray",
            "label": "gray",
            "swatch": "#6b7280"
          }
        ]
      }
    ]
  },
  "presetsLabel": "tools",
